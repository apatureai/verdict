{
  "name": "@apatureai/verdict-serve",
  "version": "0.1.4",
  "private": true,
  "license": "MIT",
  "type": "module",
  "description": "Local HTTP deployment of the job API: submit and poll real critiques with no database, object store or capture fleet.",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "bin": {
    "judgment-engine-serve": "./dist/main.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "test": "vitest run"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.5.4",
    "@apatureai/verdict-api": "workspace:*",
    "@apatureai/verdict-capture": "workspace:*",
    "@apatureai/verdict-cli": "workspace:*",
    "@apatureai/verdict-context": "workspace:*",
    "@apatureai/verdict-critique": "workspace:*",
    "@apatureai/verdict-db": "workspace:*",
    "@apatureai/verdict-jobs": "workspace:*",
    "@apatureai/verdict-review": "workspace:*",
    "@apatureai/verdict-runtime": "workspace:*",
    "@apatureai/verdict-storage": "workspace:*",
    "@apatureai/verdict-types": "workspace:*"
  }
}
