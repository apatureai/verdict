{
  "name": "@apatureai/verdict-runtime",
  "version": "0.1.3",
  "private": true,
  "license": "MIT",
  "type": "module",
  "description": "Production API and worker composition roots for the Judgment Engine.",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": { "types": "./dist/index.d.ts", "default": "./dist/index.js" },
    "./http": { "types": "./dist/http.d.ts", "default": "./dist/http.js" },
    "./worker": { "types": "./dist/worker.d.ts", "default": "./dist/worker.js" },
    "./input": { "types": "./dist/input.d.ts", "default": "./dist/input.js" }
  },
  "files": ["dist"],
  "scripts": { "test": "vitest run" },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1091.0",
    "@apatureai/verdict-api": "workspace:*",
    "@apatureai/verdict-capture": "workspace:*",
    "@apatureai/verdict-context": "workspace:*",
    "@apatureai/verdict-critique": "workspace:*",
    "@apatureai/verdict-db": "workspace:*",
    "@apatureai/verdict-eval": "workspace:*",
    "@apatureai/verdict-jobs": "workspace:*",
    "@apatureai/verdict-observability": "workspace:*",
    "@apatureai/verdict-review": "workspace:*",
    "@apatureai/verdict-secrets": "workspace:*",
    "@apatureai/verdict-storage": "workspace:*",
    "@apatureai/verdict-types": "workspace:*",
    "openai": "^6.48.0",
    "pg": "^8.22.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.4",
    "@types/pg": "^8.11.10"
  }
}
