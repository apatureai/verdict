{
  "name": "@apatureai/verdict-capture",
  "version": "0.1.3",
  "license": "MIT",
  "author": "Aditya Prathapa",
  "type": "module",
  "description": "verdict capture worker: deterministic Chromium capture, DOM geometry, and the code-computed contrast / overflow / touch-target checks.",
  "keywords": ["verdict", "design-review", "wcag", "contrast", "accessibility", "playwright"],
  "homepage": "https://github.com/apatureai/verdict/tree/main/packages/capture#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/apatureai/verdict.git",
    "directory": "packages/capture"
  },
  "bugs": { "url": "https://github.com/apatureai/verdict/issues" },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": { "types": "./dist/index.d.ts", "default": "./dist/index.js" },
    "./playwright": { "types": "./dist/playwright-browser.d.ts", "default": "./dist/playwright-browser.js" }
  },
  "files": ["dist"],
  "publishConfig": { "access": "public", "provenance": true },
  "scripts": {
    "build": "tsc -b",
    "test": "vitest run",
    "prepublishOnly": "tsc -b"
  },
  "dependencies": {
    "@apatureai/verdict-types": "workspace:*",
    "playwright-core": "1.62.1"
  }
}
