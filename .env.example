# Runtime configuration for packages/runtime (api-main.ts / worker-main.ts).
# Placeholders only; never commit real values. Startup fails fast if any
# required variable is missing; there is no mock fallback in production.
#
# Note that CAPTURE_ENDPOINT must point at a capture-worker SERVICE that is not
# part of this repository. The in-process browser capture the CLI uses
# (createBrowserCapture in @apatureai/verdict-capture) needs none of these variables. See
# the Limitations table in README.md.

# --- Required secrets ---------------------------------------------------------
DATABASE_URL=postgresql://user:password@host:5432/judgment_engine
ENGINE_HMAC_SECRET=replace-me
MODEL_API_KEY=replace-me
OBJECT_STORE_ACCESS_KEY_ID=replace-me
OBJECT_STORE_SECRET_ACCESS_KEY=replace-me
CAPTURE_API_TOKEN=replace-me

# --- Required configuration ---------------------------------------------------
MODEL_BASE_URL=https://dashscope-intl.aliyuncs.com/compatible-mode/v1
CAPTURE_ENDPOINT=https://capture.example.internal
OBJECT_STORE_BUCKET=judgment-engine-artifacts

# --- Optional: model routing (defaults shown) ---------------------------------
# MODEL_BACKEND=dashscope         # dashscope | self-host
# TRIAGE_MODEL=qwen3-vl-flash
# DEEP_MODEL=qwen3-vl-plus

# --- Optional: object store selection -----------------------------------------
# OBJECT_STORE_REGION=auto        # "auto" for R2, an AWS region for S3
# OBJECT_STORE_ENDPOINT=https://<account>.r2.cloudflarestorage.com

# --- Optional: UI DNA grounding (all three together, or none) -----------------
# Setting these also enables the publication-time authority recheck.
# GENOME_ENDPOINT=https://ui-dna.example.internal
# GENOME_API_TOKEN=replace-me
# EMBEDDING_MODEL=replace-me
# AUTHORITY_TIMEOUT_MS=2000
# AUTHORITY_MAX_AGE_MS=60000

# --- Optional: server + worker tuning (defaults shown) ------------------------
# PORT=8080
# WORKER_POLL_MS=5000
# WORKER_MAX_ATTEMPTS=3
# WORKER_LEASE_MS=60000
# JOB_MAX_ATTEMPT_MS=720000
